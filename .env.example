# Copiez ce fichier en .env (gitignoré) avant de lancer docker-compose, et
# remplacez CHAQUE valeur ci-dessous — ne jamais garder ces défauts en
# production ou sur un poste exposé.

POSTGRES_DB=lubrimanager
POSTGRES_USER=lubrimanager
POSTGRES_PASSWORD=change-me-strong-password

# Secret HS256 pour signer les JWT — 32 caractères minimum, aléatoire.
# Génération rapide : openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-32-character-minimum-secret

# Mot de passe du compte administrateur créé au premier démarrage
# (username "admin") — à changer immédiatement après la première connexion.
ADMIN_PASSWORD=change-me-on-first-login

# URL que le frontend utilise pour appeler l'API (figée au build de l'image).
# Laissez la valeur par défaut si vous accédez à l'app depuis le même poste
# que docker-compose.
VITE_API_BASE_URL=http://localhost:8080
